#!/bin/sh

set -o errexit
set -o pipefail
set -o nounset

AVATAR_DIR=/app/ghostwriter/media/images/user_avatars
EVIDENCE_DIR=/app/ghostwriter/media/evidence
TEMPLATE_DIR=/app/ghostwriter/media/templates
ARCHIVE_DIR=/app/ghostwriter/media/archives

TEMPLATE_PATH_DOCX=/app/ghostwriter/reporting/templates/reports/template.docx
TEMPLATE_PATH_PPTX=/app/ghostwriter/reporting/templates/reports/template.pptx

[[ ! -d "$EVIDENCE_DIR" ]] && mkdir -p "$EVIDENCE_DIR" && chown -R django "$EVIDENCE_DIR"
[[ ! -d "$AVATAR_DIR" ]] && mkdir -p "$AVATAR_DIR" && chown -R django "$AVATAR_DIR"
[[ ! -d "$TEMPLATE_DIR" ]] && mkdir -p "$TEMPLATE_DIR" && chown -R django "$TEMPLATE_DIR"
[[ ! -d "$ARCHIVE_DIR" ]] && mkdir -p "$ARCHIVE_DIR" && chown -R django "$ARCHIVE_DIR"

cp -u -p "$TEMPLATE_PATH_DOCX" "$TEMPLATE_DIR"
cp -u -p "$TEMPLATE_PATH_PPTX" "$TEMPLATE_DIR"

python /app/manage.py collectstatic --noinput
python /app/manage.py migrate
# /usr/local/bin/daphne -b 0.0.0.0 -p 8000 config.asgi:application
# With WEB_CONCURRENCY > 1, uvicorn's multiprocess supervisor pings each
# worker over an internal pipe and SIGKILLs + respawns any worker that
# doesn't answer within --timeout-worker-healthcheck (default: 5s) -- even
# if the worker was never crashed/hung, just busy holding the GIL on a slow
# synchronous view (e.g. rendering a project with a large data_artifacts
# payload). Raise the timeout so legitimately-slow-but-healthy requests
# aren't killed mid-response.
#
# --limit-max-requests: rendering a project page retains some RSS per view
# that Python's own reference counting frees correctly, but the musl libc
# allocator (Alpine, this image's base) doesn't return to the OS as
# aggressively as glibc -- a well-documented Python-on-Alpine memory-bloat
# pattern, confirmed via per-request memory checkpoints showing worker RSS
# climb across a worker's lifetime. Most of the per-view cost has since been
# fixed at the source (stripping large, never-rendered data_artifacts
# sub-structures -- see _strip_large_unused_artifacts in rolodex/views.py),
# but some residual growth remains, mainly from template render execution
# itself. Recycling each worker after a bounded number of requests (uvicorn
# detects the clean exit and respawns automatically, same supervisor
# mechanism as the healthcheck above) caps how much any single worker can
# accumulate before it's replaced with a fresh, low-RSS process -- kept
# tighter than strictly necessary post-fix as a hedge while running with
# more concurrent workers again.
#
# jemalloc addresses the same root cause more directly (returning freed
# memory to the OS instead of just recycling around it) -- discover the
# installed .so path here rather than hardcoding one, since the exact
# filename can vary by jemalloc/Alpine version and a wrong hardcoded path
# would silently no-op instead of erroring.
JEMALLOC_PATH=$(find /usr/lib /usr/local/lib -name 'libjemalloc.so*' 2>/dev/null | head -n 1)
if [ -n "$JEMALLOC_PATH" ]; then
  export LD_PRELOAD="$JEMALLOC_PATH"
  echo "Using jemalloc ($LD_PRELOAD) to mitigate musl malloc memory retention"
else
  echo "WARNING: jemalloc .so not found -- continuing without LD_PRELOAD override"
fi

uvicorn config.asgi:application --host 0.0.0.0 --port 8000 --timeout-worker-healthcheck 33 --limit-max-requests 50
